{
  "name": "@sqlrag/standalone-runner",
  "version": "1.0.0",
  "description": "Level 2 test harness — runs the four SAM plugins as a standalone Node.js Express server, outside SAM. Provides a real `ctx` with live Opera SE + per-plugin SQLite for testing the rewritten apps before they're packaged for SAM.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@sqlrag/balance-check": "*",
    "@sqlrag/bank-reconcile": "*",
    "@sqlrag/gocardless": "*",
    "@sqlrag/suppliers": "*",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "knex": "^3.1.0",
    "tedious": "^16.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}

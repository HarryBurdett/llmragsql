    "clean": "rm -rf dist"
  },
  "dependencies": {
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}

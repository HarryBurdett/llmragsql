{
  "name": "@sqlrag/sam-shared",
  "version": "1.0.0",
  "description": "Shared utilities for SQL RAG SAM plugins (Opera SQL helpers, posting primitives, types).",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./opera": "./dist/opera/index.js",
    "./posting": "./dist/posting/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",

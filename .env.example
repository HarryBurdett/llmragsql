# SQL RAG — Environment Variable Contract
# ==========================================================
#
# This file lists every environment variable the applications read.
# Copy to `.env` for local docker-compose use:
#
#     cp .env.example .env
#     # edit values
#     docker compose up
#
# For SAM platform deployment: SAM populates these env vars (or
# whichever ones the apps actually consume — see per-app sections
# below). The application code reads from os.environ regardless of
# what put values there.
#
# Resolution order in the running app (highest first):
#   1. Env var (this file when running docker-compose)
#   2. config.ini at the repo root (development convenience only)
#   3. Caller-supplied fallback in cfg.get(..., fallback=X)
#
# Naming convention: [section] key in config.ini → SECTION_KEY in env.

# =============================================================
# DATABASE — Opera SQL Server (SE) connection
# =============================================================
# Required for: bank-reconcile, gocardless, suppliers, balance-check
# Provided by SAM: yes (SAM owns the Opera SQL connection)

DATABASE_TYPE=mssql
DATABASE_SERVER=
DATABASE_PORT=1433
DATABASE_DATABASE=
DATABASE_USE_WINDOWS_AUTH=false
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_CONNECTION_TIMEOUT=30
DATABASE_COMMAND_TIMEOUT=60
DATABASE_SSL=false
DATABASE_TRUST_SERVER_CERTIFICATE=true

# =============================================================
# OPERA — Version selector (SE | 3)
# =============================================================
# Some routes branch on this. SE is the default.

OPERA_VERSION=SE

# =============================================================
# OPERA 3 — FoxPro DBF location + Write Agent
# =============================================================
# Required for: any Opera 3 route handler
# Provided by SAM: yes (file share + write-agent URL)
# These can be omitted on SE-only deployments.

OPERA3_DATA_PATH=
OPERA3_WRITE_AGENT_URL=

# =============================================================
# EMAIL — IMAP receive
# =============================================================
# Required for: bank-reconcile (statement scan), gocardless (payout
# scan), suppliers (statement scan)
# Provided by SAM: yes (one mailbox shared across all consumers)

EMAIL_IMAP_ENABLED=true
EMAIL_IMAP_SERVER=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USE_SSL=true
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=

# =============================================================
# EMAIL — SMTP send
# =============================================================
# Required for: gocardless (remittance), suppliers (remittance)
# Provided by SAM: yes

EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# =============================================================
# AI providers — used for PDF extraction and natural-language
# queries. Pick one (Gemini is the production default).
# =============================================================
# Provided by SAM: yes (centralised AI key)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional alternative providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# =============================================================
# MODELS — provider routing + embedding
# =============================================================

MODELS_PROVIDER=gemini
MODELS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================
# GOCARDLESS — payment platform integration
# =============================================================
# Required for: gocardless app only
# Use sandbox tokens in development (DO NOT make live API requests
# against the production endpoint while testing).

GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=

# =============================================================
# SYSTEM — logging + behaviour
# =============================================================

SYSTEM_LOG_LEVEL=INFO
SYSTEM_RAG_AUTO_POPULATE=false

# =============================================================
# UI — frontend port
# =============================================================

UI_WEB_PORT=8501

# =============================================================
# SAM — platform integration (post-migration)
# =============================================================
# Set these when the apps are running inside SAM. They tell the
# apps where to find SAM's services for auth, secrets, service
# discovery, etc. Empty during pre-SAM Docker deployment.

SAM_ENABLED=false
SAM_AUTH_URL=
SAM_SECRETS_URL=
SAM_SERVICE_REGISTRY_URL=
AUTH_JWT_PUBLIC_KEY=

# =============================================================
# Inter-service URLs — used during the per-app split (Phase B)
# =============================================================
# When apps are split into separate containers, each app needs to
# know where the others (and the shared core services) live. These
# are populated by docker-compose / SAM, not edited manually.

CORE_EMAIL_URL=
CORE_OPERA_SE_URL=
CORE_OPERA3_URL=
CORE_AUTH_URL=
BANK_RECONCILE_URL=
GOCARDLESS_URL=
SUPPLIERS_URL=
BALANCE_CHECK_URL=

# =============================================================
# Paths — host filesystem locations
# =============================================================
# COMPANY_DATA_BASE_PATH: where per-company SQLite databases live
#                        (defaults to repo-relative ./data)
# CONFIG_INI_PATH:       optional override for the config.ini path
#                        (development only — leave unset in containers)

COMPANY_DATA_BASE_PATH=./data
# CONFIG_INI_PATH=
